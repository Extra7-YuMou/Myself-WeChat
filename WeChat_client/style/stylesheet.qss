}

#search_edit{
    padding: 5px;
    border: 2px solid #DCDCDC;
    border-radius: 10px;
}

#data_edit{
    background-color: rgba(0, 0, 0, 0);
}

#send_btn[state="unvalid"]{
    background-color: #D3D3D3;
    border-radius: 10px;
    color: #708090;
}

#send_btn[state="valid"]{
    background-color: #43CD80;
    border-radius: 10px;
    color: #F5F5F5;
}

#data_list{
    border: 0px;
    background-color: transparent;
}

/* 让整个 ChatView 透明 */
#data_list,
#data_list > QScrollArea,
#data_list > QScrollArea > QWidget,
#data_list > QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

#chat_data_wid {
    background-color: #ffffff;
}

#send_data_wid{
    border: 2px solid #DCDCDC;
    border-radius: 10px;
    background-color: #ffffff;
}

#data_edit{
    font-family: "Microsoft YaHei";
    border: none;
    padding: 5px;
}

#chat_user_list, #con_user_list, #search_list{
    background-color: #F5F5F5;
}

#chat_user_list::item:selected {
    background-color: #07C160;
    border: none;
    outline: none;
}

#chat_user_list::item:hover {
    background-color: rgb(206, 207,208);
    border: none;
    outline: none;
}
#chat_user_list::focus {
    border: none;
    outline: none;
}

#search_edit {
    border: 2px solid #f1f1f1;
}
/* 搜索框列表*/
#con_user_list {
    background-color: rgb(247,247,248);
    border: none;
}
#con_user_list::item:selected {
    background-color: #d3d7d4;
    border: none;
    outline: none;
}
#con_user_list::item:hover {
    background-color: rgb(206,207,208);
    border: none;
    outline: none;
}
#con_user_list::focus {
    border: none;
    outline: none;
}
#invalid_item {
    background-color: #eaeaea;
    border: none;
}
#add_tip {
    border-image: url(:/images/addtip.png);
}
#right_tip{
 border-image: url(:/images/right_tip.png);
}
#message_tip{
  text-align: center;
  font-family: "Microsoft YaHei";
  font-size: 12pt;
}

/* 垂直滚动条整体 */
QScrollBar:vertical {
    background: #F0F0F0;          /* 背景色 */
    width: 8px;                  /* 滚动条宽度 */
    margin: 0px 0px 0px 0px;      /* 外边距 */
    border-radius: 4px;
}

/* 滚动条滑块（拖动的部分） */
QScrollBar::handle:vertical {
    background: #C0C0C0;          /* 滑块颜色 */
    min-height: 30px;             /* 最小高度 */
}

/* 滑块悬停效果（可选） */
QScrollBar::handle:vertical:hover {
    background: #A0A0A0;
}

/* 滑块按下效果 */
QScrollBar::handle:vertical:pressed {
    background: #808080;
}

#side_head_lb{
    border-radius: 10px;
}
